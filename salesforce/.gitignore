# ========================
secrets.json
secrets.yaml
config.json
slack_webhook.txt
webhook_url.txt

# ========================
# IDE
# ========================
.vscode/
.idea/
*.swp
*.swo

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

